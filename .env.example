# ==============================================================================
# ARCHITECTURE RENDER STUDIO - ENVIRONMENT VARIABLES
# ==============================================================================

# [REQUIRED - SERVER ONLY]
# Google Gemini API key for generating architectural visualizations.
# In Google AI Studio, this is automatically injected at runtime from user secrets.
# For Vercel or local development, obtain your key at https://aistudio.google.com/
# NEVER expose this key to client-side code or browser bundles.
GEMINI_API_KEY=""

# [OPTIONAL / RECOMMENDED - SERVER ONLY]
# Server-side Supabase URL for verifying tokens and backend database operations.
# Can match NEXT_PUBLIC_SUPABASE_URL or VITE_SUPABASE_URL.
SUPABASE_URL=""

# [OPTIONAL / RECOMMENDED - SERVER ONLY]
# Supabase Service Role Key for backend administration and server-side storage writes.
# Keep this strictly secret on the server. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=""

# [OPTIONAL - CLIENT & SERVER (NEXT.JS COMPATIBILITY)]
# Supabase Project URL for Next.js deployments.
NEXT_PUBLIC_SUPABASE_URL=""

# [OPTIONAL - CLIENT & SERVER (NEXT.JS COMPATIBILITY)]
# Supabase Anon / Publishable Key for Next.js deployments.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# [OPTIONAL - CLIENT & SERVER (VITE SPA COMPATIBILITY)]
# In Vite, client env vars are prefixed with VITE_.
# The app automatically synchronizes both prefixes.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# [RECOMMENDED - SERVER ONLY]
# Target URL where the app is hosted (e.g. Cloud Run, Vercel, or http://localhost:3000).
APP_URL="http://localhost:3000"
